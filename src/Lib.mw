-- ariadne: fancy diagnostics for compilers and other tools that point into
-- text. A port of Rust's `ariadne` crate, version 0.6.0, measuring text with
-- this ecosystem's `unicodeWidth`.
--
--   use ariadne (build, withMessage, withLabel, label, labelMessage, spanIn, sources, render)
--
--   def report =
--     build Error (spanIn "a.mw" 8 11)
--       |> withMessage "unknown name"
--       |> withLabel (label (spanIn "a.mw" 8 11) |> labelMessage "not in scope")
--
--   render report (sources [("a.mw", "def x = foo\n")])
--     -- Error: unknown name
--     --    ╭─[ a.mw:1:9 ]
--     --    │
--     --  1 │ def x = foo
--     --    │         ─┬─
--     --    │          ╰─── not in scope
--     -- ───╯
--
-- (with colour escapes, unless the configuration turns colour off).

